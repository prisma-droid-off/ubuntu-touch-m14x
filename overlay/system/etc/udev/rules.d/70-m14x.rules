# ==============================================================================
# /etc/udev/rules.d/70-m14x.rules
# Hardware & Subsystem Permissions for Samsung Galaxy M14 5G (Exynos 1380)
# ==============================================================================

# --- Core Android IPC & Memory (Binder, Ashmem, ION, TZ, DMA) ---
ACTION=="add|change", KERNEL=="binder", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add|change", KERNEL=="hwbinder", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add|change", KERNEL=="vndbinder", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add|change", KERNEL=="ashmem*", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add|change", KERNEL=="ion*", OWNER="system", GROUP="system", MODE="0666"
ACTION=="add|change", KERNEL=="pmsg0", OWNER="root", GROUP="log", MODE="0222"
ACTION=="add|change", KERNEL=="hw_random", OWNER="prng_seeder", GROUP="prng_seeder", MODE="0400"
ACTION=="add|change", KERNEL=="dmabuf_container", OWNER="cameraserver", GROUP="camera", MODE="0660"
ACTION=="add|change", KERNEL=="dmabuf_trace", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="exynos-mem", OWNER="system", GROUP="graphics", MODE="0660"
ACTION=="add|change", KERNEL=="s5p-smem", OWNER="system", GROUP="system", MODE="0660"

# TrustZone / Secure World
ACTION=="add|change", KERNEL=="tzdev", OWNER="system", GROUP="system", MODE="0666"
ACTION=="add|change", KERNEL=="tziwsock", OWNER="system", GROUP="system", MODE="0666"
ACTION=="add|change", KERNEL=="tzirs", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="tziwshmem", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="camellia_iwc", OWNER="root", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="proca_config", OWNER="system", GROUP="system", MODE="0440"
ACTION=="add|change", KERNEL=="tuihw", OWNER="system", GROUP="system", MODE="0660"

# --- DMA Heap Buffers ---
ACTION=="add|change", SUBSYSTEM=="dma_heap", OWNER="root", GROUP="system", MODE="0666"
ACTION=="add|change", KERNEL=="dma_heap/camera*", OWNER="system", GROUP="camera", MODE="0666"
ACTION=="add|change", KERNEL=="dma_heap/secure_camera-secure", OWNER="system", GROUP="camera", MODE="0660"
ACTION=="add|change", KERNEL=="dma_heap/crypto*", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="dma_heap/system*", OWNER="system", GROUP="system", MODE="0444"
ACTION=="add|change", KERNEL=="dma_heap/system-secure-vstream-secure", OWNER="system", GROUP="drmrpc", MODE="0444"
ACTION=="add|change", KERNEL=="dma_heap/vframe-secure", OWNER="system", GROUP="drmrpc", MODE="0660"
ACTION=="add|change", KERNEL=="dma_heap/vscaler-secure", OWNER="system", GROUP="system", MODE="0660"

# --- Graphics & GPU (Mali, Direct Rendering Manager) ---
ACTION=="add|change", KERNEL=="dri/card*", OWNER="system", GROUP="graphics", MODE="0666"
ACTION=="add|change", KERNEL=="dri/*", OWNER="root", GROUP="graphics", MODE="0666"
ACTION=="add|change", KERNEL=="mali*", OWNER="system", GROUP="system", MODE="0666"
ACTION=="add|change", KERNEL=="fimg2d", OWNER="system", GROUP="graphics", MODE="0666"
ACTION=="add|change", KERNEL=="g2d", OWNER="system", GROUP="graphics", MODE="0660"
ACTION=="add|change", KERNEL=="graphics/*", OWNER="root", GROUP="graphics", MODE="0660"
ACTION=="add|change", KERNEL=="ump", OWNER="system", GROUP="graphics", MODE="0666"
ACTION=="add|change", KERNEL=="HPD", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="kgsl*", OWNER="system", GROUP="system", MODE="0666"

# --- Camera, ISP & V4L2 Subsystem ---
ACTION=="add|change", KERNEL=="v4l-subdev*", OWNER="system", GROUP="camera", MODE="0666"
ACTION=="add|change", KERNEL=="video*", OWNER="cameraserver", GROUP="camera", MODE="0666"
ACTION=="add|change", KERNEL=="media*", OWNER="system", GROUP="camera", MODE="0666"
ACTION=="add|change", KERNEL=="dsp", OWNER="cameraserver", GROUP="camera", MODE="0664"
ACTION=="add|change", KERNEL=="is_tuning*", OWNER="cameraserver", GROUP="camera", MODE="0666"
ACTION=="add|change", KERNEL=="m2m1shot*", OWNER="cameraserver", GROUP="camera", MODE="0666"
ACTION=="add|change", KERNEL=="vertex*", OWNER="cameraserver", GROUP="camera", MODE="0666"

# --- Input & Touchscreen ---
ACTION=="add|change", KERNEL=="input/*", OWNER="root", GROUP="input", MODE="0666"
ACTION=="add|change", SUBSYSTEM=="input", OWNER="root", GROUP="input", MODE="0666"
ACTION=="add|change", KERNEL=="event*", OWNER="root", GROUP="input", MODE="0666", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="spi", KERNEL=="spi3.0", ATTR{power/control}="on"
ACTION=="add|change", KERNEL=="v4l-touch*", OWNER="root", GROUP="input", MODE="0660"
ACTION=="add|change", KERNEL=="uhid", OWNER="uhid", GROUP="uhid", MODE="0660"
ACTION=="add|change", KERNEL=="uinput", OWNER="uhid", GROUP="uhid", MODE="0660"

# --- Cellular, Radio & Modem (oFono / RIL / Samsung CP) ---
ACTION=="add|change", KERNEL=="block/by-name/cp_debug", OWNER="radio", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="block/by-name/modem*", OWNER="radio", GROUP="radio", MODE="0440"
ACTION=="add|change", KERNEL=="block/by-name/radio", OWNER="system", GROUP="radio", MODE="0660"
ACTION=="add|change", KERNEL=="dit2", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add|change", KERNEL=="drb", OWNER="system", GROUP="radio", MODE="0660"
ACTION=="add|change", KERNEL=="ppp", OWNER="radio", GROUP="vpn", MODE="0660"
ACTION=="add|change", KERNEL=="ramdump_memshare", OWNER="system", GROUP="radio", MODE="0660"
ACTION=="add|change", KERNEL=="rmnet*", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add|change", KERNEL=="smd*", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add|change", KERNEL=="umts*", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add|change", KERNEL=="umts_atc0", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="umts_ciq*", OWNER="system", GROUP="system_ext_bridge_rw", MODE="0660"
ACTION=="add|change", KERNEL=="umts_csd", OWNER="system", GROUP="loop_radio", MODE="0660"
ACTION=="add|change", KERNEL=="umts_dm0", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="umts_ramdump0", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add|change", KERNEL=="umts_router", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="usnet*", OWNER="radio", GROUP="inet", MODE="0660"

# --- Wireless, Bluetooth & Connectivity ---
ACTION=="add|change", KERNEL=="wlan*", OWNER="wifi", GROUP="wifi", MODE="0660"
ACTION=="add|change", KERNEL=="mx_0_*", OWNER="wifi", GROUP="wifi", MODE="0660"
ACTION=="add|change", KERNEL=="mx140_usb_clk_test_0", OWNER="wifi", GROUP="wifi", MODE="0660"
ACTION=="add|change", KERNEL=="mx_client_test_0", OWNER="wifi", GROUP="wifi", MODE="0660"
ACTION=="add|change", KERNEL=="scsc_*", OWNER="wifi", GROUP="wifi", MODE="0660"
ACTION=="add|change", KERNEL=="scsc_h4_0", OWNER="bluetooth", GROUP="bluetooth", MODE="0660"

# --- Audio & Media Hardware ---
ACTION=="add|change", KERNEL=="snd/*", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add|change", KERNEL=="seiren", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add|change", KERNEL=="vts_fio_dev", OWNER="audioserver", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="hdcp2", OWNER="media", GROUP="media", MODE="0660"

# --- Storage Partitions & System Infrastructure ---
ACTION=="add|change", KERNEL=="block/by-name/param", OWNER="root", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="block/by-name/persistent", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="block/by-name/persist", OWNER="system", GROUP="system", MODE="0600"
ACTION=="add|change", KERNEL=="block/by-name/steady", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="i2c-2", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="iio:device*", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="rtc0", OWNER="system", GROUP="system", MODE="0640"
ACTION=="add|change", KERNEL=="shub_*", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="ssp", OWNER="system", GROUP="system", MODE="0660"

# --- Serial TTY, USB & Virtualization ---
ACTION=="add|change", KERNEL=="bus/usb/*", OWNER="root", GROUP="usb", MODE="0660"
ACTION=="add|change", KERNEL=="mtp_usb", OWNER="root", GROUP="mtp", MODE="0660"
ACTION=="add|change", KERNEL=="usb_accessory", OWNER="root", GROUP="usb", MODE="0660"
ACTION=="add|change", KERNEL=="tty0", OWNER="root", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="ttyGS*", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="tun", OWNER="system", GROUP="vpn", MODE="0660"
ACTION=="add|change", KERNEL=="kvm", OWNER="system", GROUP="system", MODE="0600"
ACTION=="add|change", KERNEL=="vhost-vsock", OWNER="system", GROUP="system", MODE="0600"

# --- Base Linux Char Devices ---
ACTION=="add|change", KERNEL=="full", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add|change", KERNEL=="null", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add|change", KERNEL=="zero", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add|change", KERNEL=="ptmx", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add|change", KERNEL=="tty", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add|change", KERNEL=="random", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add|change", KERNEL=="urandom", OWNER="root", GROUP="root", MODE="0666"
